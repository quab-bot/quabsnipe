# ─────────────────────────────────────────────────────────────────────
#  QUABSNIPE v10 — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git — your private key is in here
# ─────────────────────────────────────────────────────────────────────


# ── TRADING MODES ────────────────────────────────────────────────────
#
#   SIGNAL_TRADING  controls the signal bot (Telegram channels)
#
#   ON  = LIVE  — executes REAL trades with REAL money
#   OFF = PAPER — watches and logs only, spends NO real SOL
#
#   SIGNAL_ENABLED is not needed here — the channel listener always runs.
#   SIGNAL_TRADING is the only switch you need:
#     off = receive signals, paper trade only (safe default)
#     on  = receive signals AND execute real trades with real money
#
# SIGNAL_TRADING=off

# Private group signals — format: invite_hash:username1,username2 (semicolon separated)
SIGNAL_GROUPS=vL0kDCn0iYJlMzdk:defimaestro90

# Paper trading toggle
PAPER_TRADING_ENABLED=true

# AI scorer — minimum confidence to trade (0.52 = 52%)
AI_THRESHOLD=0.55

# Paper drawdown limit — pause when balance drops below this % of starting
PAPER_DRAWDOWN_LIMIT=0.75
AI_ENABLED=true  → paper mode, receives signals but no real trades (default)
# SIGNAL_TRADING=on   → live mode, executes real trades with real money
SIGNAL_TRADING=off

# Private group signals — format: invite_hash:username1,username2 (semicolon separated)
SIGNAL_GROUPS=vL0kDCn0iYJlMzdk:defimaestro90

# Paper trading toggle
PAPER_TRADING_ENABLED=true

# AI scorer — minimum confidence to trade (0.52 = 52%)
AI_THRESHOLD=0.55

# Paper drawdown limit — pause when balance drops below this % of starting
PAPER_DRAWDOWN_LIMIT=0.75
AI_ENABLED=true


# ── SIGNAL CHANNEL ───────────────────────────────────────────────────
#
#   Set SIGNAL_TRADING=on above to activate the channel monitor.
#   SIGNAL_CHANNELS is the list of Telegram channels to watch.
#
SIGNAL_CHANNELS=solearlytrending,soltrenchtrending,BlocApe_Signal_Calls,trenchfree


# ── Helius API (https://helius.dev) ──────────────────────────────────
#   Free tier is fine for paper trading.
#   For live trading get at least the Developer plan ($50/mo).
#
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here


# ── Wallets ──────────────────────────────────────────────────────────
SNIPER_WALLET_PRIVATE_KEY=your_sniper_wallet_private_key_base58
PROFIT_WALLET_ADDRESS=your_profit_wallet_public_address
COLD_WALLET_ADDRESS=your_cold_wallet_public_address


# ── Telegram Bot (https://t.me/BotFather) ───────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id


# ── POSITION SIZING ──────────────────────────────────────────────────
#
#   SNIPER_POSITION  = % of wallet per sniper trade (e.g. 0.10 = 10%)
#   SIGNAL_POSITION_USD = fixed dollar amount per signal trade
#
#   SNIPER_POSITION by wallet size:
#     $40  → 0.10  (10% = ~$4/trade)
#     $75  → 0.15  (15% = ~$11/trade)
#     $150 → 0.20  (20% = ~$30/trade)
#
#   SIGNAL_POSITION_USD — straightforward, just set the dollar amount:
#     $40 wallet → 3   (= $3/trade, ~15 trades before empty)
#     $75 wallet → 5   (= $5/trade)
#     $150 wallet→ 10  (= $10/trade)
#
SNIPER_POSITION=0.10
SIGNAL_POSITION_USD=3


# ── Risk Guards ──────────────────────────────────────────────────────
DAILY_LOSS_LIMIT_PCT=0.30
LOW_BALANCE_USD=5.0
MIN_TRADE_USD=2
MAX_TRADE_USD=500


# ── Telegram Signal Automation (Telethon) ───────────────────────────
#   Required only if SIGNAL_ENABLED=true.
#   Get from https://my.telegram.org/apps → API development tools.
#
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+234XXXXXXXXXX


# ── Other ─────────────────────────────────────────────────────────────
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1
HEARTBEAT_INTERVAL_HOURS=6
